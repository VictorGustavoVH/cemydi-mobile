EXPO_PUBLIC_API_URL=http://192.168.1.100:4000
EXPO_PUBLIC_APP_ENV=development
# Origen público de la web para términos y privacidad. Opcional.
EXPO_PUBLIC_WEBSITE_URL=

# Credenciales OAuth de Google (Google Cloud Console)
# ID de cliente de aplicación Web (requerido para backend y Android Credential Manager)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=""
# ID de cliente de aplicación iOS (requerido para iOS)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
## Expo push: UUID del proyecto EAS. No contiene una credencial privada.
EXPO_PUBLIC_EAS_PROJECT_ID=
## Ruta local o variable File de EAS para google-services.json (Android/FCM).
GOOGLE_SERVICES_JSON=
