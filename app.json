{
  "expo": {
    "name": "Ortopedia CEMYDI",
    "slug": "cemydi-mobile",
    "scheme": "cemydi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icons/app-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "experiments": {
      "typedRoutes": true
    },
    "androidStatusBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#FFFFFF",
      "translucent": true
    },
    "android": {
      "icon": "./assets/icons/android-adaptive-foreground.png",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/icons/android-adaptive-foreground.png",
        "monochromeImage": "./assets/icons/android-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/icons/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/icons/splash-icon.png",
          "imageWidth": 192,
          "resizeMode": "contain"
        }
      ],
      "expo-font",
      "expo-image"
    ]
  }
}
