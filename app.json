{
  "expo": {
    "name": "Ortopedia CEMYDI",
    "slug": "cemydi-mobile",
    "scheme": "cemydi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icons/app-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cemydi.app"
    },
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "com.cemydi.app",
      "icon": "./assets/icons/android-adaptive-foreground.png",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/icons/android-adaptive-foreground.png",
        "monochromeImage": "./assets/icons/android-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/icons/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/icons/splash-icon.png",
          "imageWidth": 192,
          "resizeMode": "contain"
        }
      ],
      "expo-font",
      "expo-image",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Permite que CEMYDI use el micrófono para buscar productos por voz.",
          "speechRecognitionPermission": "Permite que CEMYDI convierta tu voz en texto para buscar productos."
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "defaultChannel": "cemydi"
        }
      ]
    ],
    "extra": {
      "googleNativeConfigured": false,
      "router": {},
      "eas": {
        "projectId": "390e351f-5e63-4af9-a925-49e54545f25e"
      }
    },
    "owner": "victor_valdivia"
  }
}
